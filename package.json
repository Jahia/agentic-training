{
  "name": "forsure",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist",
    "src/**/*.cnd",
    "settings",
    "static"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && run package",
    "check-setup": "node scripts/check-setup.mjs",
    "clean": "rm -rf dist/",
    "deploy": "jahia-deploy",
    "dev": "vite build --watch",
    "format": "prettier --write --list-different .",
    "lint": "eslint .",
    "mcp-token": "node scripts/mcp-token.mjs",
    "package": "yarn pack --out dist/package.tgz",
    "seed": "node scripts/seed.mjs",
    "test": "playwright test",
    "watch": "run dev",
    "watch:callback": "run package && run deploy"
  },
  "dependencies": {
    "modern-normalize": "^3.0.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^2.0.0",
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.26.0",
    "@jahia/javascript-modules-library": "^1.3.1",
    "@jahia/vite-plugin": "^1.3.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.1.2",
    "eslint": "^9.26.0",
    "globals": "^16.0.0",
    "i18next": "^26.0.0",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-i18next": "^17.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1",
    "typescript-plugin-css-modules": "^5.1.0",
    "vite": "^7.0.0"
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "jahia": {
    "name": "forsure",
    "required-version": "8.2.1.0",
    "snapshot": true,
    "module-dependencies": "default",
    "module-type": "templatesSet",
    "server": "dist/server/index.js",
    "static-resources": "/dist/client,/dist/assets,/locales,/images,/icons"
  }
}
